### `azotyl.c` (Communication Implementation)

```c
#include "azotyl.h"
#include "uart.h" // Assuming a UART library exists
#include <string.h>

#define MAX_AZOTYLS 8

static int16_t azotyl_offsets[MAX_AZOTYLS];

void azotyl_init(void) {
    for (int i = 0; i < MAX_AZOTYLS; i++) {
        azotyl_offsets[i] = 0;
    }
}

void azotyl_process(void) {
    if (uart_available()) {
        uint8_t packet_type = uart_read();
        
        if (packet_type == PKT_AZOTYL_STATE) {
            packet_azotyl_state_t pkt;
            uart_read_bytes((uint8_t*)&pkt, sizeof(pkt));
            
            if (pkt.azotyl_id < MAX_AZOTYLS) {
                azotyl_offsets[pkt.azotyl_id] = pkt.offset;
                
                // Send ACK back
                azotyl_send_ack(pkt.azotyl_id, pkt.offset, 1);
            }
        }
    }
}

int16_t azotyl_get_offset(uint8_t azotyl_id) {
    if (azotyl_id < MAX_AZOTYLS) {
        return azotyl_offsets[azotyl_id];
    }
    return 0;
}

void azotyl_set_offset(uint8_t azotyl_id, int16_t offset) {
    if (azotyl_id < MAX_AZOTYLS) {
        azotyl_offsets[azotyl_id] = offset;
        
        // Broadcast state change
        packet_azotyl_state_t pkt;
        pkt.header = PKT_AZOTYL_STATE;
        pkt.azotyl_id = azotyl_id;
        pkt.offset = offset;
        pkt.i = 0;
        pkt.count = 1;
        
        uart_write_bytes((uint8_T*)&pkt, sizeof(pkt));
    }
}

void azotyl_send_ack(uint8_t azotyl_id, int16_t offset, uint8_t success) {
    packet_azotyl_ack_t ack;
    ack.header = PKT_AZOTYL_ACK;
    ack.azotyl_id = azotyl_id;
    ack.offset = offset;
    ack.success = success;
    
    uart_write_bytes((uint8_t*)&ack, sizeof(ack));
}
```

